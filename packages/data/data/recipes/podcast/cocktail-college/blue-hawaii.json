{
  "$schema": "../../../../schemas/recipe.schema.json",
  "name": "Blue Hawaii",
  "preparation": "flash blended",
  "served_on": "crushed ice",
  "glassware": "hurricane",
  "ingredients": [
    {
      "name": "Saline",
      "type": "other",
      "quantity": {
        "amount": 5,
        "unit": "drop"
      }
    },
    {
      "name": "gum syrup",
      "type": "syrup",
      "quantity": {
        "amount": 1,
        "unit": "tsp"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lime punch syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Pineapple juice",
      "type": "juice",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    },
    {
      "name": "Giffard Blue Curaçao",
      "type": "liqueur",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Denizen Aged White",
      "type": "spirit",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Vodka",
      "type": "category",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Plymouth Gin",
      "type": "spirit",
      "optional": true,
      "technique": {
        "technique": "fat-wash",
        "fat": "coconut oil"
      },
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Combine lemon juice and lime punch syrup (sour mix), pineapple juice, rum, vodka (or the coconut-oil-washed gin), blue curaçao, gum syrup, saline, and 8 ounces of crushed ice in a large tin",
    "Flash blend for 3 to 5 seconds",
    "Put the remaining 4 ounces of crushed ice into a Hurricane glass",
    "Pour the blended mixture into the glass",
    "Garnish with a pineapple leaf, pineapple wedge, orchid, and blue cocktail umbrella"
  ],
  "attributions": [
    {
      "relation": "adapted by",
      "source": "Garret Richard"
    }
  ],
  "refs": [
    {
      "type": "podcast",
      "episodeTitle": "The Cocktail College Podcast: How to Make the Perfect Blue Hawaii",
      "episodeLink": "https://vinepair.com/cocktail-college/blue-hawaii/"
    }
  ]
}

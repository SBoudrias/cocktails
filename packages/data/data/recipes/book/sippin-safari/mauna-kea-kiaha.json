{
  "$schema": "../../../../schemas/recipe.schema.json",
  "name": "Mauna Kea Kiaha",
  "preparation": "flash blended",
  "served_on": "crushed ice",
  "glassware": "footed pilsner",
  "ingredients": [
    {
      "name": "Cream of coconut",
      "type": "syrup",
      "brix": 66,
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Coconut milk",
      "type": "other",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Coffee liqueur",
      "type": "category",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Blended Lightly-aged Rum",
      "type": "category",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Combine all ingredients in a drink mixer tin with 8 oz crushed ice.",
    "Flash blend and open pour into a footed pilsner glass.",
    "Garnish with a pineapple frond and a mint sprig."

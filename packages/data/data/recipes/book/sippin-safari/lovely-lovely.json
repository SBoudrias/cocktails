  "name": "Lovely Lovely",
  "preparation": "flash blended",
  "served_on": "crushed ice",
  "glassware": "snifter",
  "ingredients": [
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Brown sugar",
      "type": "other",
      "quantity": {

{
  "$schema": "../../../../schemas/recipe.schema.json",
  "name": "Polynesian Guava Daiquiri",
  "preparation": "flash blended",
  "served_on": "crushed ice",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "guava juice",
      "type": "juice",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Banana liqueur",
      "type": "category",
      "quantity": {
        "amount": 1,
        "unit": "tsp"
      }
    },
    {
      "name": "Gin",
      "type": "category",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Combine all ingredients in a drink mixer tin with 3 oz crushed ice and flash blend for 5 seconds.",
    "Open pour into an old fashioned glass and top with crushed ice.",
    "Garnish with a mint sprig."
  ]
}

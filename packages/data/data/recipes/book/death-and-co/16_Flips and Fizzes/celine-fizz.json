  "name": "Celine Fizz",
  "preparation": "shaken",
  "served_on": "up",
  "glassware": "collins",
  "ingredients": [
    {
      "name": "Egg white",
      "type": "emulsifier",
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {

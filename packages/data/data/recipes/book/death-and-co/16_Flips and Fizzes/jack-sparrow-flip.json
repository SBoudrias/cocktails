  "name": "Jack Sparrow Flip",
  "preparation": "shaken",
  "served_on": "up",
  "glassware": "collins",
  "ingredients": [
    {
      "name": "Whole egg",
      "type": "other",
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "Fee Brothers Whiskey Barrel-Aged Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {

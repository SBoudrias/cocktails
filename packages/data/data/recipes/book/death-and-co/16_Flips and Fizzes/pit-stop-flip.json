{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Pit Stop Flip",
  "preparation": "shaken",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "Egg yolk",
      "type": "other",
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "Maple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Heavy whipping cream",
      "type": "other",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Sandeman Rainwater Madeira",
      "type": "wine",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Laird's Bonded Apple Brandy",
      "type": "spirit",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Dry shake all the ingredients, then shake again with ice. Double strain into a coupe. Garnish with a few grates of nutmeg and rest the apple slice on the edge of the coupe."
  ],

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Raisin Burn",
  "preparation": "shaken",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "Whole egg",
      "type": "other",
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "Angostura bitters",
      "type": "bitter",
      "quantity": {
        "amount": 1,
        "unit": "dash"
      }
    },
    {
      "name": "Heavy whipping cream",
      "type": "other",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lustau East India Solera Sherry",
      "type": "wine",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Wild Turkey Rye",
      "type": "spirit",
      "technique": {
        "technique": "infusion",
        "agent": "dried currant"
      },
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Dry shake all the ingredients, then add 1 large ice cube and shake again. Double strain into a coupe. Garnish with a few grates of cinnamon."
  ],

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Chinese Fizz",
  "preparation": "shaken",
  "served_on": "ice cubes",
  "glassware": "collins",
  "ingredients": [
    {
      "name": "Egg white",
      "type": "emulsifier",
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "Angostura bitters",
      "type": "bitter",
      "quantity": {
        "amount": 1,
        "unit": "dash"
      }
    },
    {
      "name": "Grenadine",
      "type": "syrup",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Simple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Cointreau",
      "type": "liqueur",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Luxardo Maraschino Liqueur",
      "type": "liqueur",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Appleton Signature",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Dry shake all the ingredients, then shake again with ice. Double strain into a fizz glass filled with ice cubes. Garnish with the orange wheel and serve with a straw."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Phil Ward"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 245
    }
  ]
}

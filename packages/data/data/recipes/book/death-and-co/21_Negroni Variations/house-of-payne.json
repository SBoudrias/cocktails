{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "House of Payne",
  "preparation": "stirred",
  "served_on": "big rock",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "raspberries",
      "type": "fruit",
      "technique": {
        "technique": "muddled"
      },
      "quantity": {
        "amount": 3,
        "unit": "unit"
      }
    },
    {
      "name": "Plymouth Sloe Gin",
      "type": "liqueur",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Campari",
      "type": "liqueur",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Beefeater London Dry Gin",
      "type": "spirit",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a mixing glass, gently muddle the raspberries.",
    "Add the remaining ingredients and stir over ice.",
    "Double strain into a double rocks glass over 1 large ice cube.",
    "Garnish with the raspberry."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Phil Ward"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 258
    }
  ]
}

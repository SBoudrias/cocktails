{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "The Vanderbilt",
  "preparation": "stirred",
  "served_on": "big rock",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Mathilde poire",
      "type": "liqueur",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Gran Classico Bitter",
      "type": "liqueur",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Laird's Bonded Apple Brandy",
      "type": "spirit",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Stir all the ingredients over ice, then strain into a double rocks glass over 1 large ice cube.",
    "No garnish."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Scott Teague"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 259
    }
  ]
}

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Hispaniola",
  "preparation": "stirred",
  "served_on": "big rock",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Ginger syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Cane syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Flor de Caña 4 year",
      "type": "spirit",
      "technique": {
        "technique": "infusion",
        "agent": "Summer Royale tea"
      },
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Stir all the ingredients over ice, then strain into a double rocks glass over 1 large ice cube. Garnish with a lime wheel."
  ],
  "attributions": [

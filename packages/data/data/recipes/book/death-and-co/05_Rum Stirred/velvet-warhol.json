{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Velvet Warhol",
  "preparation": "stirred",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "Bitter Truth Aromatic Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Marie Brizard White Crème de Cacao",
      "type": "liqueur",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Goslings Black Seal Rum",
      "type": "spirit",
      "technique": {
        "technique": "infusion",
        "agent": "banana chips"
      },
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    },
    {
      "name": "Heavy whipping cream",
      "type": "other",
      "technique": {
        "technique": "application",
        "method": "float"
      },
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Stir all the ingredients (except the cream) over ice, then strain into a coupe.",
    "Float the cream on top. No garnish."
  ],
  "attributions": [

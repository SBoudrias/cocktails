{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Black Market Sling",
  "preparation": "shaken",
  "served_on": "ice cubes",
  "glassware": "highball",
  "ingredients": [
    {
      "name": "Angostura bitters",
      "type": "bitter",
      "quantity": {
        "amount": 1,
        "unit": "dash"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Simple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Dolin Sweet Vermouth de Chambéry",
      "type": "wine",
      "technique": {
        "technique": "infusion",
        "agent": "cinnamon orange tea"
      },
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Plymouth Gin",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    },
    {
      "name": "Seltzer",
      "type": "soda",
      "technique": {
        "technique": "application",
        "method": "top"
      },
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    }
  ],
  "instructions": [
    "Shake all the ingredients (except the club soda) with ice, then strain into a highball glass filled with ice cubes. Top with club soda. Garnish with the cherries and serve with a straw."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Phil Ward"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 252
    }
  ]
}

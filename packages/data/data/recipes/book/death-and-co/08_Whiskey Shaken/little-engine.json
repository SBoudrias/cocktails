{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Little Engine",
  "preparation": "shaken",
  "served_on": "crushed ice",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Apple butter",
      "type": "other",
      "quantity": {
        "amount": 1,
        "unit": "tsp"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Maple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Otima 10-Year Tawny Port",
      "type": "wine",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Famous Grouse",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Short shake all the ingredients with 3 ice cubes, then double strain into a double rocks glass filled with crushed ice. Garnish with 1 apple fan and serve with a straw."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Alex Day"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 201
    }
  ]
}

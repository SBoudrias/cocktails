{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Scotch Lady",
  "preparation": "shaken",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "Egg white",
      "type": "emulsifier",
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "Grenadine",

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Swearengen Sling",
  "preparation": "shaken",
  "served_on": "ice cubes",
  "glassware": "highball",
  "ingredients": [
    {
      "name": "cocktail cherry",
      "type": "fruit",
      "quantity": {
        "amount": 2,
        "unit": "unit"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Simple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Amaro Nonino",
      "type": "liqueur",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Cherry Heering liqueur",
      "type": "category",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Bulleit Bourbon",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a shaker, muddle the brandied cherries. Add the remaining ingredients and shake with ice. Strain into a highball glass filled with ice cubes. Garnish with 1 brandied cherry on a cocktail pick and serve with a straw."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Brian Miller"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 202
    }
  ]
}

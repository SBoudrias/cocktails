{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Double Fill-Up",
  "preparation": "shaken",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "Mint leaves",
      "type": "other",
      "quantity": {
        "amount": 3,
        "unit": "unit"
      }
    },
    {
      "name": "pomegranate molasses",
      "type": "other",
      "quantity": {
        "amount": 1,
        "unit": "tsp"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Simple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Rittenhouse Rye",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Shake all the ingredients with ice, then double strain into a coupe. Garnish with 1 mint leaf."
  ],
  "attributions": [

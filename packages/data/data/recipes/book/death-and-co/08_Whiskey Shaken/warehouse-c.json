  "name": "Warehouse C",
  "preparation": "shaken",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "Strawberry",
      "type": "fruit",
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "Bitter Truth Aromatic Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 1,
        "unit": "dash"
      }

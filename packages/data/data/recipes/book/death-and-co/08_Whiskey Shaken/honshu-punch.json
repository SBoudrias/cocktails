  "name": "Honshu Punch",
  "preparation": "shaken",
  "served_on": "big rock",
  "glassware": "snifter",
  "ingredients": [
    {
      "name": "Fee Brothers Whiskey Barrel-Aged Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Bitter Truth Aromatic Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Pineapple juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Cane syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Yamazaki 12 Year",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    },
    {
      "name": "Seltzer",
      "type": "soda",
      "technique": {
        "technique": "application",
        "method": "top"
      },

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Fix Me Up",
  "preparation": "shaken",
  "served_on": "big rock",
  "glassware": "snifter",
  "ingredients": [
    {
      "name": "Angostura bitters",
      "type": "bitter",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Orange juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Orgeat",
      "type": "category",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Sazerac Straight Rye Whiskey",
      "type": "spirit",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Lustau Amontillado Los Arcos Sherry",
      "type": "wine",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    },
    {
      "name": "Seltzer",
      "type": "soda",
      "technique": {
        "technique": "application",
        "method": "top"
      },
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Short shake all the ingredients except the seltzer with 3 ice cubes, then strain into a snifter over 1 large ice cube. Pour in the seltzer. No garnish."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Thomas Waugh"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 200
    }
  ]
}

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Whirling Tiger",
  "preparation": "shaken",
  "served_on": "ice cubes",
  "glassware": "highball",
  "ingredients": [
    {
      "name": "Ginger syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Fuji apple juice",
      "type": "juice",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Buffalo Trace Bourbon",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Shake all the ingredients with ice, then strain into a highball glass filled with ice cubes. Garnish with 1 Fuji apple slice and serve with a straw."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Brian Miller"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 203
    }
  ]
}

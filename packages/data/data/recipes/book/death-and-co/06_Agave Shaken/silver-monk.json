{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Silver Monk",
  "preparation": "shaken",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "Cucumber",
      "type": "fruit",
      "technique": [
        {
          "technique": "cut",
          "type": "wheeled"
        },
        {
          "technique": "muddled"
        }
      ],
      "quantity": {
        "amount": 2,
        "unit": "unit"
      }
    },
    {
      "name": "Mint leaves",
      "type": "other",
      "technique": {
        "technique": "muddled"
      },
      "quantity": {
        "amount": 8,
        "unit": "unit"
      }
    },
    {
      "name": "Simple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Yellow Chartreuse",
      "type": "liqueur",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Siembra Azul Blanco",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    },
    {
      "name": "Salt",
      "type": "other",
      "quantity": {
        "amount": 1,
        "unit": "pinch"
      }
    }
  ],
  "instructions": [
    "In a shaker, muddle the cucumber wheels with the mint and salt.",
    "Add the remaining ingredients and shake with ice.",
    "Double strain into a coupe.",
    "No garnish."
  ],

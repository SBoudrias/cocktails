{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "St. Matilda",
  "preparation": "shaken",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "pear",
      "type": "fruit",
      "technique": {
        "technique": "cut",
        "type": "cubed"
      },
      "quantity": {
        "amount": 0.5,
        "unit": "unit"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Simple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Mathilde poire",
      "type": "liqueur",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Siembra Azul Blanco",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a shaker, muddle the pear.",

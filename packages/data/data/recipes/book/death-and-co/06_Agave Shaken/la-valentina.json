{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "La Valentina",
  "preparation": "shaken",
  "served_on": "crushed ice",
  "glassware": "footed pilsner",
  "ingredients": [
    {
      "name": "raspberries",
      "type": "fruit",
      "technique": {
        "technique": "muddled"
      },
      "quantity": {
        "amount": 3,
        "unit": "unit"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Simple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Grapefruit juice",
      "type": "juice",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Don Julio Blanco Tequila",
      "type": "spirit",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    },
    {
      "name": "Salt",
      "type": "other",
      "quantity": {
        "amount": 1,
        "unit": "pinch"
      }
    },
    {
      "name": "Blanche de Bruxelles",
      "type": "beer",
      "technique": {
        "technique": "application",
        "method": "top"
      },
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a shaker, gently muddle the raspberries.",
    "Add the remaining ingredients (except the beer) and short shake with 3 ice cubes.",
    "Double strain into a pilsner glass filled with crushed ice, then pour in the beer.",
    "Garnish with the raspberries and serve with a straw."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Thomas Waugh"
    },
    {
      "relation": "bar",
      "source": "Death & Co",
      "location": "New York, NY"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 184
    }
  ]
}

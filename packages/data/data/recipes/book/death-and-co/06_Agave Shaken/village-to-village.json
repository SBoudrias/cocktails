{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Village to Village",
  "preparation": "shaken",
  "served_on": "crushed ice",
  "glassware": "footed pilsner",
  "ingredients": [
    {
      "name": "Ginger syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "tsp"
      }
    },
    {
      "name": "Acacia honey syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Apple juice",
      "type": "juice",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    },
    {
      "name": "St-Elizabeth Allspice Dram",
      "type": "liqueur",
      "quantity": {
        "amount": 0.5,
        "unit": "tsp"
      }
    },
    {
      "name": "Chinaco Verde Blanco Tequila",
      "type": "spirit",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Short shake all the ingredients with 3 ice cubes, then strain into a pilsner glass filled with crushed ice.",
    "Garnish with the bitters and the mint sprig and serve with a straw."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Thomas Waugh"
    },
    {
      "relation": "bar",
      "source": "Death & Co",
      "location": "New York, NY"
    }
  ],
  "refs": [

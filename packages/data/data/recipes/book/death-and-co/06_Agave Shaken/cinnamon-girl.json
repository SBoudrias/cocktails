{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Cinnamon Girl",
  "preparation": "shaken",
  "served_on": "crushed ice",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "orange",
      "type": "fruit",
      "technique": [
        {
          "technique": "cut",
          "type": "wedged"
        },
        {
          "technique": "muddled"
        }
      ],
      "quantity": {
        "amount": 2,
        "unit": "unit"
      }
    },
    {
      "name": "Death & Co Orange Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 1,
        "unit": "dash"
      }
    },
    {
      "name": "Cassia Cinnamon Bark syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Cane syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Smith & Cross",
      "type": "spirit",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Siete Leguas Reposado Tequila",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Trembling Bell",
  "preparation": "stirred",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "lemon",
      "type": "fruit",
      "technique": {
        "technique": "cut",
        "type": "zested"
      },
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "Acacia honey syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "tsp"
      }
    },
    {
      "name": "G.E. Massenez Crème de Pêche",
      "type": "liqueur",
      "quantity": {
        "amount": 1,
        "unit": "tsp"
      }
    },
    {
      "name": "Cocchi Americano",
      "type": "wine",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Knappogue Castle 12 Year Irish Whiskey",
      "type": "spirit",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Old Overholt Straight Rye Whiskey",
      "type": "spirit",
      "technique": {
        "technique": "infusion",
        "agent": "chamomile"
      },
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Stir all the ingredients except the lemon twist over ice, then strain into a coupe. Squeeze the lemon twist over the drink and discard. No garnish."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Thomas Waugh"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 209
    }
  ]
}

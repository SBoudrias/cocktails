{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Black Market Manhattan",
  "preparation": "stirred",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "Angostura bitters",
      "type": "bitter",
      "quantity": {
        "amount": 1,
        "unit": "dash"
      }
    },
    {
      "name": "Sweet vermouth",
      "type": "category",
      "technique": {
        "technique": "infusion",
        "agent": "cinnamon-orange black tea"
      },
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Bernheim Original Wheat Whiskey",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Stir all the ingredients over ice, then strain into a coupe. Garnish with 1 lemon twist."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Brian Miller"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 204
    }
  ]
}

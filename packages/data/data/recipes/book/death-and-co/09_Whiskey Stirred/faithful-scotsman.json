{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Faithful Scotsman",
  "preparation": "stirred",
  "served_on": "big rock",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Cumin syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Pineapple juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "G.E. Massenez Crème de Pêche",
      "type": "liqueur",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Compass Box Artist Blend Scotch Whisky",
      "type": "spirit",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Stir all the ingredients, then strain into a double rocks glass over 1 large ice cube. Garnish with 1 pineapple leaf."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Joaquín Simó"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 206
    }
  ]
}

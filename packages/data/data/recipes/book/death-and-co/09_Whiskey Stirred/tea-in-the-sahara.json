{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Tea in the Sahara",
  "preparation": "stirred",
  "served_on": "up",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "lemon",
      "type": "fruit",
      "technique": {
        "technique": "cut",
        "type": "disc"
      },
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "Acacia honey syrup",
      "type": "syrup",
      "quantity": {
        "amount": 1,
        "unit": "tsp"
      }
    },
    {
      "name": "Strega",
      "type": "liqueur",
      "quantity": {
        "amount": 1,
        "unit": "tsp"
      }
    },
    {
      "name": "Famous Grouse",
      "type": "spirit",
      "technique": {
        "technique": "infusion",
        "agent": "coconut green tea"
      },
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Squeeze the lemon coin, with a bit of pith, over a mixing glass and drop it in. Add the remaining ingredients and stir with ice. Strain into a double rocks glass. No garnish."
  ],
  "attributions": [
    {
      "relation": "recipe author",

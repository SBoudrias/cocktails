{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Ramble",
  "preparation": "shaken",
  "served_on": "crushed ice",
  "glassware": "highball",
  "ingredients": [
    {
      "name": "raspberries",
      "type": "fruit",
      "technique": {
        "technique": "muddled"
      },
      "quantity": {
        "amount": 3,
        "unit": "unit"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Simple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 1.25,
        "unit": "oz"
      }
    },
    {
      "name": "Plymouth Gin",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a shaker, combine the gin, lemon juice, and ¾ ounce of the simple syrup. Short shake with 3 ice cubes, then strain into a highball glass filled with crushed ice. Empty the shaker, then add the raspberries and the remaining ½ ounce simple syrup. Gently muddle the raspberries, then pour over the top of the drink and serve with a straw."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Phil Ward"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 160
    }
  ]
}

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Waterloo Sunset",
  "preparation": "shaken",
  "served_on": "big rock",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Mint leaves",
      "type": "other",
      "technique": {
        "technique": "muddled"
      },
      "quantity": {
        "amount": 7,
        "unit": "unit"
      }
    },
    {
      "name": "Cane syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Watermelon juice",
      "type": "juice",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    },
    {
      "name": "Dolin Blanc Vermouth de Chambéry",
      "type": "wine",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Plymouth Gin",
      "type": "spirit",
      "technique": {
        "technique": "infusion",
        "agent": "Szechuan peppercorn"
      },
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Beefeater London Dry Gin",
      "type": "spirit",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a shaker, gently muddle the mint leaves and syrup. Add the remaining ingredients and shake with ice, then double strain into a double rocks glass over 1 large ice cube. Garnish with the mint sprig."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Joaquín Simó"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 161
    }
  ]
}

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Soul Clench",
  "preparation": "stirred",
  "served_on": "big rock",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "John D. Taylor's Velvet Falernum",
      "type": "liqueur",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Combier Pamplemousse Rose",
      "type": "liqueur",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "St-Germain",
      "type": "liqueur",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Dolin Dry Vermouth de Chambéry",
      "type": "wine",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Waqar Pisco",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Stir all the ingredients over ice.",
    "Strain into a double rocks glass over 1 large ice cube.",
    "Garnish with a grapefruit twist."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Jillian Vose"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 219
    }
  ]
}

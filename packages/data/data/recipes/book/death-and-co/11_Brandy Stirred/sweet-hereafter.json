{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Sweet Hereafter",
  "preparation": "stirred",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "Grapefruit",
      "type": "fruit",
      "technique": {
        "technique": "cut",
        "type": "peeled"
      },
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "Bittermens Hopped Grapefruit Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 1,
        "unit": "dash"
      }
    },
    {
      "name": "St-Germain",
      "type": "liqueur",
      "quantity": {
        "amount": 1,
        "unit": "tsp"
      }
    },
    {
      "name": "Cocchi Americano",
      "type": "wine",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Dolin Blanc Vermouth de Chambéry",
      "type": "wine",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Campo de Encanto Acholado",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Squeeze the grapefruit twist over a mixing glass and discard it.",

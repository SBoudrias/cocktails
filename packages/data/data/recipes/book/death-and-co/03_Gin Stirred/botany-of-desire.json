{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Botany of Desire",
  "preparation": "stirred",
  "served_on": "up",
  "glassware": "nick & nora",
  "ingredients": [
    {
      "name": "Death & Co Orange Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 1,
        "unit": "dash"
      }
    },
    {
      "name": "Cane syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "tsp"
      }
    },
    {
      "name": "Fusion Verjus Blanc",
      "type": "other",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    },
    {
      "name": "Elixir Combier",
      "type": "liqueur",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Busnel VSOP Calvados",
      "type": "spirit",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "The Botanist Islay Dry Gin",
      "type": "spirit",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Stir all the ingredients over ice, then strain into a Nick & Nora glass. Garnish with the apple fan."

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Mexi-Gin Martini",
  "preparation": "stirred",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "Bitter Truth Celery Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 1,
        "unit": "dash"
      }
    },
    {
      "name": "Del Maguey Crema de Mezcal",
      "type": "spirit",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Siembra Azul Blanco",
      "type": "spirit",
      "technique": {
        "technique": "infusion",
        "agent": "jalapeño"
      },
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Green Chartreuse",
      "type": "liqueur",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Dolin Dry Vermouth de Chambéry",
      "type": "wine",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Plymouth Gin",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Stir all the ingredients over ice, then strain into a coupe. No garnish."
  ],
  "attributions": [

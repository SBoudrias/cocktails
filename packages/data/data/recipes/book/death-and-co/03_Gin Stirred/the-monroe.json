{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "The Monroe",
  "preparation": "stirred",
  "served_on": "big rock",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Death & Co Orange Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 1,
        "unit": "dash"
      }
    },
    {
      "name": "Death & Co Peychaud's Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 3,
        "unit": "dash"
      }
    },
    {
      "name": "Orgeat",
      "type": "category",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "G.E. Massenez Crème de Pêche",
      "type": "liqueur",
      "quantity": {
        "amount": 0.5,
        "unit": "tsp"
      }
    },
    {
      "name": "Gin (New American)",
      "type": "category",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    },
    {
      "name": "Seltzer",
      "type": "soda",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Stir all the ingredients (except the club soda) over ice, then strain into a double rocks glass over 1 large ice cube. Add the club soda. No garnish."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Scott Teague"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 166
    }
  ]
}

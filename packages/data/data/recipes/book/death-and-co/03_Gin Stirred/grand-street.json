{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Grand Street",
  "preparation": "stirred",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "Grapefruit",
      "type": "fruit",
      "technique": [
        {
          "technique": "cut",
          "type": "peeled"
        },
        {
          "technique": "muddled"
        }

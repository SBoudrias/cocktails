      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "Luxardo Maraschino Liqueur",
      "type": "liqueur",
      "quantity": {
        "amount": 1,
        "unit": "tsp"
      }
    },
    {

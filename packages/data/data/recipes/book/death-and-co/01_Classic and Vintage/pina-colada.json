{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Pina Colada",
  "preparation": "shaken",
  "served_on": "crushed ice",
  "glassware": "tiki",
  "ingredients": [
    {
      "name": "Angostura bitters",
      "type": "bitter",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Kalani Coconut Liqueur",
      "type": "liqueur",
      "quantity": {
        "amount": 3,
        "unit": "dash"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Cream of coconut",
      "type": "syrup",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Pineapple juice",
      "type": "juice",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Black blended overproof rum",
      "type": "category",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "El Dorado 3 Year",
      "type": "spirit",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Smith & Cross",
      "type": "spirit",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Short shake all the ingredients with 3 ice cubes, then strain into a coconut mug filled with crushed ice. Garnish with the mint bouquet and serve with a straw."
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 148
    }
  ]
}

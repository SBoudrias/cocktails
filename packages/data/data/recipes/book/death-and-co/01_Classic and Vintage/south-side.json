{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "South Side",
  "preparation": "shaken",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "Mint leaves",
      "type": "other",
      "technique": {
        "technique": "muddled"
      },
      "quantity": {
        "amount": 5,
        "unit": "unit"
      }
    },
    {
      "name": "Angostura bitters",
      "type": "bitter",
      "quantity": {
        "amount": 1,
        "unit": "dash"
      }
    },
    {
      "name": "Cane syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Cobra's Fang",
  "preparation": "shaken",
  "served_on": "crushed ice",
  "glassware": "tiki",
  "ingredients": [
    {
      "name": "Angostura bitters",
      "type": "bitter",
      "quantity": {
        "amount": 1,
        "unit": "dash"
      }
    },
    {
      "name": "Vieux Pontarlier Absinthe",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Ginger syrup",
      "type": "syrup",
      "quantity": {
        "amount": 1,
        "unit": "tsp"
      }
    },
    {
      "name": "Orange juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Passion fruit syrup",
      "type": "category",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Cassia Cinnamon Bark syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "G.E. Massenez Crème de Pêche",
      "type": "liqueur",
      "quantity": {
        "amount": 1,
        "unit": "tsp"
      }
    },
    {
      "name": "Black blended overproof rum",
      "type": "category",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Appleton 8",
      "type": "spirit",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Short shake all the ingredients with 3 ice cubes, then strain into a tiki mug filled with crushed ice. Garnish with the mint sprig and lime wheel and serve with a straw."
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 141
    }
  ]
}

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Sazerac",
  "preparation": "stirred",
  "served_on": "up",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Vieux Pontarlier Absinthe",
      "type": "spirit",
      "technique": {
        "technique": "application",
        "method": "rinse"
      },
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "lemon",
      "type": "fruit",
      "technique": {
        "technique": "cut",
        "type": "peeled"
      },
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "Angostura bitters",
      "type": "bitter",
      "quantity": {
        "amount": 1,
        "unit": "dash"
      }
    },
    {
      "name": "Peychaud's bitters",
      "type": "bitter",
      "quantity": {
        "amount": 4,
        "unit": "dash"
      }
    },
    {
      "name": "Demerara syrup",
      "type": "syrup",
      "quantity": {
        "amount": 1,
        "unit": "tsp"
      }
    },
    {
      "name": "Pierre Ferrand 1840 Cognac",
      "type": "spirit",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Rittenhouse Rye",
      "type": "spirit",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Rinse a rocks glass with absinthe and dump. Stir the remaining ingredients (except the lemon twist) over ice, then strain into the glass. Squeeze the lemon twist over the drink and discard. No garnish."
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 151
    }
  ]
}

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Dark and Stormy",
  "preparation": "shaken",
  "served_on": "ice cubes",
  "glassware": "highball",
  "ingredients": [
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Ginger syrup",
      "type": "syrup",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Goslings Black Seal Rum",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    },
    {
      "name": "Seltzer",
      "type": "soda",
      "technique": {
        "technique": "application",
        "method": "top"
      },
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    }
  ],
  "instructions": [
    "In a shaker, combine all the ingredients (except the club soda) and whip (shake with a few pieces of crushed ice just until the ingredients are incorporated). Strain into a highball glass filled with ice cubes. Top with club soda. Garnish with the lime wheel and candied ginger flag and serve with a straw."
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 142
    }
  ]
}

  "name": "Pink Lady",
  "preparation": "shaken",
  "served_on": "big rock",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Egg white",
      "type": "emulsifier",
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "Grenadine",
      "type": "syrup",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {

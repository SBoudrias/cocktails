{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Queen's Park Swizzle",
  "preparation": "swizzled",
  "served_on": "crushed ice",
  "glassware": "footed pilsner",
  "ingredients": [
    {
      "name": "Sugar cube",
      "type": "other",
      "technique": {
        "technique": "muddled"
      },
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "Mint leaves",
      "type": "other",
      "technique": {
        "technique": "muddled"
      },
      "quantity": {
        "amount": 10,
        "unit": "unit"
      }
    },
    {
      "name": "Angostura bitters",
      "type": "bitter",
      "quantity": {
        "amount": 4,
        "unit": "dash"
      }
    },
    {
      "name": "Simple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Column still lightly aged rum",
      "type": "category",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a shaker, gently muddle the mint with the simple syrup and sugar cube. Add the rum and lime juice and whip (shake with a few pieces of crushed ice just until the ingredients are incorporated). Dump into a pilsner glass filled with crushed ice. Swizzle until cold, then top with the bitters and swizzle them into the top of the drink. Garnish with the mint sprig and serve with a straw."
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 150
    }
  ]
}

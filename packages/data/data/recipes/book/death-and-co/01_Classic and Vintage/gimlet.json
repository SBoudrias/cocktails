{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Gimlet",
  "preparation": "shaken",
  "served_on": "crushed ice",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "lime cordial",
      "type": "syrup",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    },
    {
      "name": "Perry's Tot Navy Strength Gin",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Shake the gin and lime cordial with ice, then strain into a double rocks glass over cracked ice. Garnish with the lime wedge."
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 143
    }
  ]
}

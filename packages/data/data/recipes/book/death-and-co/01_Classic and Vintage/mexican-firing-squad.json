{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Mexican Firing Squad",
  "preparation": "shaken",
  "served_on": "crushed ice",
  "glassware": "highball",
  "ingredients": [
    {
      "name": "Bittermens Hellfire Habanero Shrub",
      "type": "bitter",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Grenadine",
      "type": "syrup",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Cane syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Tapatio 110 Proof Blanco",
      "type": "spirit",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Fill a highball glass with cracked ice. Short shake all the ingredients with 3 ice cubes, then strain into the glass. Garnish with the lime wheel and cherry flag and serve with a straw."
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 146
    }
  ]
}

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Paloma",
  "preparation": "shaken",
  "served_on": "ice cubes",
  "glassware": "highball",
  "ingredients": [
    {
      "name": "lime",
      "type": "fruit",
      "technique": {
        "technique": "cut",
        "type": "wedged"
      },
      "quantity": {
        "amount": 0.5,
        "unit": "unit"
      }
    },
    {
      "name": "Simple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Grapefruit juice",
      "type": "juice",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }

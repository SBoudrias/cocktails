{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Seersucker",
  "preparation": "shaken",
  "served_on": "crushed ice",
  "glassware": "footed pilsner",
  "ingredients": [
    {
      "name": "Strawberry",
      "type": "fruit",
      "technique": {
        "technique": "muddled"
      },
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "Cassia Cinnamon Bark syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Flor de Caña 4 year",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a shaker, gently muddle the strawberry. Add the remaining ingredients and short shake with 3 ice cubes.",
    "Strain into a pilsner glass filled with crushed ice. Garnish with a strawberry and serve with a straw."
  ],

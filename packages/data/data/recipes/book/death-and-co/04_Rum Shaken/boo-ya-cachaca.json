{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Boo-Ya Cachaça",
  "preparation": "shaken",
  "served_on": "ice cubes",
  "glassware": "highball",
  "ingredients": [
    {
      "name": "Seltzer",
      "type": "soda",
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Ginger syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Crème Yvette",
      "type": "liqueur",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Lustau Amontillado Los Arcos Sherry",
      "type": "wine",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "La Favorite Rhum Agricole Blanc",
      "type": "spirit",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Short shake all the ingredients (except the seltzer) with 3 ice cubes, then strain into a highball glass over 3 ice cubes.",
    "Top with seltzer and serve with a straw. No garnish."
  ],

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "The Gift Shop",
  "preparation": "shaken",
  "served_on": "big rock",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Cucumber",
      "type": "fruit",
      "technique": [
        {
          "technique": "cut",
          "type": "wheeled"
        },
        {
          "technique": "muddled"
        }
      ],
      "quantity": {
        "amount": 3,
        "unit": "unit"
      }
    },
    {
      "name": "Angostura bitters",
      "type": "bitter",
      "quantity": {
        "amount": 1,
        "unit": "dash"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Simple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Cardamaro",
      "type": "liqueur",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Banks 5 Island Rum",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a shaker, muddle the cucumber wheels. Add the remaining ingredients and shake with ice.",
    "Double strain into a double rocks glass over 1 large ice cube. Garnish with 3 cucumber wheels fanned on top of the drink."
  ],
  "attributions": [

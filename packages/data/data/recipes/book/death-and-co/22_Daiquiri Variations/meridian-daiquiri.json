{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Meridian Daiquiri",
  "preparation": "shaken",
  "served_on": "big rock",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "cardamom pods",
      "type": "spice",
      "technique": {
        "technique": "muddled"
      },
      "quantity": {
        "amount": 5,
        "unit": "unit"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Ginger syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Pineapple juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Scarlet Ibis Trinidad Rum",
      "type": "spirit",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Linie Aquavit",
      "type": "spirit",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a shaker, gently muddle the cardamom pods.",
    "Add the remaining ingredients and shake with ice.",
    "Strain into a double rocks glass over 1 large ice cube.",
    "Garnish with the lime wheel."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Joaquín Simó"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 263
    }
  ]
}

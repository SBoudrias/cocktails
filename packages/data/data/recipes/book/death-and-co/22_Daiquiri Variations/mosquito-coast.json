{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Mosquito Coast",
  "preparation": "shaken",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Simple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "St-Elizabeth Allspice Dram",
      "type": "liqueur",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Scarlet Ibis Trinidad Rum",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Shake all the ingredients with ice, then strain into a coupe.",
    "Garnish with the lime wedge."
  ],

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Arrack Punch",
  "preparation": "other",
  "served_on": "ice cubes",
  "glassware": "punch",
  "servings": 6,
  "ingredients": [
    {
      "name": "Demerara sugar cube",
      "type": "other",
      "quantity": {
        "amount": 16,
        "unit": "unit"
      }
    },
    {
      "name": "Bitter Truth Aromatic Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 5,
        "unit": "dash"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 3,
        "unit": "oz"
      }
    },
    {
      "name": "Luxardo Maraschino Liqueur",
      "type": "liqueur",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Batavia Arrack van Oosten",
      "type": "spirit",
      "quantity": {
        "amount": 3,
        "unit": "oz"
      }
    },
    {
      "name": "Appleton Signature",
      "type": "spirit",
      "quantity": {
        "amount": 6,
        "unit": "oz"
      }
    },
    {
      "name": "Seltzer",
      "type": "soda",
      "quantity": {
        "amount": 10,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a pitcher, muddle the sugar cubes with 4 ounces of the seltzer until the sugar is fully broken up. Add the remaining ingredients except the remaining seltzer and fill the pitcher three-quarters full with ice cubes. Stir until cold, then strain into a punch bowl over 1 large block of ice. Top with the remaining 6 ounces of seltzer. Garnish with 6 lime wheels and serve with a ladle and punch glasses."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Phil Ward"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 232
    }
  ]
}

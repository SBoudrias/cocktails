{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Valley of Kings Punch",
  "preparation": "other",
  "served_on": "ice cubes",
  "glassware": "punch",
  "servings": 6,
  "ingredients": [
    {
      "name": "White sugar cube",
      "type": "other",
      "quantity": {
        "amount": 6,
        "unit": "unit"
      }
    },
    {
      "name": "Grapefruit juice",
      "type": "juice",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    },
    {
      "name": "Pineapple juice",
      "type": "juice",
      "quantity": {
        "amount": 3,
        "unit": "oz"
      }
    },
    {
      "name": "Champagne",
      "type": "category",
      "quantity": {
        "amount": 6,
        "unit": "oz"
      }
    },
    {
      "name": "Macchu Pisco",
      "type": "spirit",
      "technique": {
        "technique": "infusion",
        "agent": "Scarlet Glow tea"
      },
      "quantity": {
        "amount": 8,
        "unit": "oz"
      }
    },
    {
      "name": "Seltzer",
      "type": "soda",
      "quantity": {
        "amount": 4,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a pitcher, muddle the sugar cubes with the seltzer until the sugar is fully broken up. Add the remaining ingredients except the champagne and fill the pitcher three-quarters full with ice cubes. Stir until cold, then strain into a punch bowl over 1 large block of ice. Top with the champagne. Garnish with 6 pineapple wedges and serve with a ladle and punch glasses."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Joaquín Simó"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 241
    }
  ]
}

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Pic-a-de-Crop Punch",
  "preparation": "other",
  "served_on": "ice cubes",
  "glassware": "punch",
  "servings": 2,
  "ingredients": [
    {
      "name": "Angostura bitters",
      "type": "bitter",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Grapefruit juice",
      "type": "juice",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Cane syrup",
      "type": "syrup",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    },
    {
      "name": "Pineapple juice",
      "type": "juice",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    },
    {
      "name": "El Dorado 151",
      "type": "spirit",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Batavia Arrack van Oosten",
      "type": "spirit",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Rothman & Winter Orchard Apricot",
      "type": "liqueur",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Plantation Barbados 5 Year",
      "type": "spirit",
      "quantity": {
        "amount": 3,
        "unit": "oz"
      }
    },
    {
      "name": "Seltzer",
      "type": "soda",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a pitcher, combine all the ingredients except the seltzer and fill the pitcher three-quarters full with ice cubes. Stir until cold, then strain into a small punch bowl over ice cubes. Top with the seltzer. Garnish with 6 lime wheels and several grates of nutmeg and serve with two straws."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Jessica Gonzalez"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 239
    }
  ]
}

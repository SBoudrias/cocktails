{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "La Fée Noir Punch",
  "preparation": "other",
  "served_on": "ice cubes",
  "glassware": "punch",
  "servings": 6,
  "ingredients": [
    {
      "name": "Blackberry",
      "type": "fruit",
      "technique": {
        "technique": "muddled"
      },
      "quantity": {
        "amount": 9,
        "unit": "unit"
      }
    },
    {
      "name": "White sugar cube",
      "type": "other",
      "quantity": {
        "amount": 9,
        "unit": "unit"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    },
    {
      "name": "Orange juice",
      "type": "juice",
      "quantity": {
        "amount": 3,
        "unit": "oz"
      }
    },
    {
      "name": "Luxardo Maraschino Liqueur",
      "type": "liqueur",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "St. George Absinthe Verte",
      "type": "spirit",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Hayman's Old Tom Gin",
      "type": "spirit",
      "quantity": {
        "amount": 6,
        "unit": "oz"
      }
    },
    {
      "name": "Seltzer",
      "type": "soda",
      "quantity": {
        "amount": 6,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a pitcher, muddle the sugar cubes with the blackberries and 3 ounces of the seltzer until the sugar is fully broken up. Add the remaining ingredients except the remaining seltzer and fill the pitcher three-quarters full with ice cubes. Stir until cold, then strain into a punch bowl over 1 large block of ice. Top with the remaining 3 ounces of seltzer. Garnish with 6 orange slices and serve with a ladle and punch glasses."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Thomas Waugh"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 236
    }
  ]
}

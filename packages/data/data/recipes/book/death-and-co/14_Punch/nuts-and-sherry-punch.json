{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Nuts and Sherry Punch",
  "preparation": "other",
  "served_on": "ice cubes",
  "glassware": "punch",
  "servings": 6,
  "ingredients": [
    {
      "name": "White sugar cube",
      "type": "other",
      "quantity": {
        "amount": 8,
        "unit": "unit"
      }
    },
    {
      "name": "Bittermens Xocolatl Mole Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Pineapple juice",
      "type": "juice",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    },
    {
      "name": "St-Elizabeth Allspice Dram",
      "type": "liqueur",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Buffalo Trace Bourbon",
      "type": "spirit",
      "technique": {
        "technique": "infusion",
        "agent": "pecan"
      },
      "quantity": {
        "amount": 3,
        "unit": "oz"
      }
    },
    {
      "name": "Lustau East India Solera Sherry",
      "type": "wine",
      "quantity": {
        "amount": 6,
        "unit": "oz"
      }
    },
    {
      "name": "Seltzer",
      "type": "soda",
      "quantity": {
        "amount": 8,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a pitcher, muddle the sugar cubes with 2 ounces of the seltzer until the sugar is fully broken up. Add the remaining ingredients except the remaining seltzer and fill the pitcher three-quarters full with ice cubes. Stir until cold, then strain into a punch bowl over 1 large block of ice. Top with the remaining 6 ounces of seltzer. Serve with a ladle and punch glasses. No garnish."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Phil Ward"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 238
    }
  ]
}

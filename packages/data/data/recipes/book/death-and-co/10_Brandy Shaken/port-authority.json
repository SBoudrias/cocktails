{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Port Authority",
  "preparation": "shaken",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "Blackberry",
      "type": "fruit",
      "technique": {
        "technique": "muddled"
      },
      "quantity": {
        "amount": 4,
        "unit": "unit"
      }
    },
    {
      "name": "Bittermens Xocolatl Mole Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Crème de Cassis",
      "type": "category",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Otima 10-Year Tawny Port",

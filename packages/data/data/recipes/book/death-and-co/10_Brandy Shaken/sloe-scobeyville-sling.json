{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Sloe Scobeyville Sling",
  "preparation": "shaken",
  "served_on": "ice cubes",
  "glassware": "highball",
  "ingredients": [
    {
      "name": "Peychaud's bitters",
      "type": "bitter",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Simple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Plymouth Sloe Gin",
      "type": "liqueur",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Laird's Bonded Apple Brandy",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    },
    {
      "name": "Seltzer",
      "type": "soda",
      "technique": {
        "technique": "application",
        "method": "top"
      },
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    }
  ],
  "instructions": [
    "Short shake all the ingredients except the seltzer with 3 ice cubes.",
    "Strain into a highball glass filled with ice cubes.",
    "Top with seltzer.",
    "Garnish with a Fuji apple slice and serve with a straw."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Phil Ward"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 214
    }
  ]
}

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Banana Cognac",
  "preparation": "shaken",
  "served_on": "crushed ice",
  "glassware": "footed pilsner",
  "ingredients": [
    {
      "name": "Angostura bitters",
      "type": "bitter",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Orgeat",
      "type": "category",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Orange juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Banana syrup",
      "type": "category",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Avua Amburana",
      "type": "spirit",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Pierre Ferrand 1840 Cognac",
      "type": "spirit",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Short shake all the ingredients with 3 ice cubes, then strain into a pilsner glass filled with crushed ice.",
    "Garnish with the dried banana chip and serve with a straw."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Tyson Buhler"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 210
    }
  ]
}

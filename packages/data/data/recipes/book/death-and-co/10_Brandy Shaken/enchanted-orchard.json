{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Enchanted Orchard",
  "preparation": "shaken",
  "served_on": "big rock",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Pineapple juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Acacia honey syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Busnel VSOP Calvados",
      "type": "spirit",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Bénédictine",
      "type": "liqueur",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Campo de Encanto Acholado",
      "type": "spirit",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Shake all the ingredients with ice, then strain into a double rocks glass over 1 large ice cube.",
    "Garnish with the cinnamon stick."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Joaquín Simó"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 210
    }
  ]
}

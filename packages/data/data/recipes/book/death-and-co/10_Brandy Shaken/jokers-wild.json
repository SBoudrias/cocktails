{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Joker's Wild",
  "preparation": "shaken",
  "served_on": "ice cubes",
  "glassware": "highball",
  "ingredients": [
    {
      "name": "Vieux Pontarlier Absinthe",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Vanilla syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Simple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "La Diablada Pisco",
      "type": "spirit",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Zoco Pacharán Navarro",
      "type": "liqueur",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    },
    {
      "name": "Seltzer",
      "type": "soda",
      "technique": {
        "technique": "application",
        "method": "top"
      },
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    }
  ],
  "instructions": [
    "Dry shake all the ingredients except the seltzer.",
    "Shake again with ice.",
    "Strain into a highball glass filled with ice cubes.",
    "Top with seltzer and garnish with a spoonful of the foam left in the tin."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Thomas Waugh"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 211
    }
  ]
}

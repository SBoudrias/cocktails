{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Guns and Rosé",
  "preparation": "stirred",
  "served_on": "up",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Death & Co Peychaud's Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Cane syrup",
      "type": "syrup",
      "quantity": {
        "amount": 1,
        "unit": "tsp"
      }
    },
    {
      "name": "Lillet Rosé",
      "type": "liqueur",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Old Grand-Dad 114 Proof Bourbon",
      "type": "spirit",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Stir all the ingredients (except the grapefruit twist) over ice, then strain into a rocks glass.",
    "Squeeze the grapefruit twist over the drink and discard.",
    "No garnish."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Scott Teague"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 256
    }
  ]
}

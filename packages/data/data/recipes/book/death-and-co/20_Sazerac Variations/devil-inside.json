  "name": "Devil Inside",
  "preparation": "stirred",
  "served_on": "up",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Laphroaig 10",
      "type": "spirit",
      "technique": {
        "technique": "application",

  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Vieux Pontarlier Absinthe",
      "type": "spirit",
      "technique": {
        "technique": "application",
        "method": "rinse"
      },
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {

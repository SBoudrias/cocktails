{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Stringer Bell",
  "preparation": "shaken",
  "served_on": "big rock",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Celery juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Cane syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Cynar",
      "type": "liqueur",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Siembra Azul Blanco",
      "type": "spirit",
      "technique": {
        "technique": "infusion",
        "agent": "jalapeño"
      },
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lustau Amontillado Los Arcos Sherry",
      "type": "wine",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    },
    {
      "name": "Kosher salt",
      "type": "spice",
      "quantity": {
        "amount": 1,
        "unit": "pinch"
      }
    }
  ],
  "instructions": [
    "Shake all the ingredients with ice, then strain into a double rocks glass over 1 large ice cube.",
    "Garnish with 1 celery stick."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Tyson Buhler"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 231
    }
  ]
}

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Midnight Mountain",
  "preparation": "stirred",
  "served_on": "big rock",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Marie Brizard White Crème de Menthe",
      "type": "liqueur",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Marie Brizard White Crème de Cacao",
      "type": "liqueur",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Carpano Antica Formula Vermouth",
      "type": "wine",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Nardini Amaro",
      "type": "liqueur",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Stir all the ingredients over ice, then strain into a double rocks glass over 1 large ice cube.",
    "Garnish with 1 orange twist."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Brad Farran"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 231
    }
  ]
}

  "name": "Fair Fault",
  "preparation": "shaken",
  "served_on": "up",
  "glassware": "wine glass",
  "ingredients": [
    {
      "name": "Cane syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {

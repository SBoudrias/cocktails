{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Have at It",
  "preparation": "shaken",
  "served_on": "ice cubes",
  "glassware": "highball",
  "ingredients": [
    {
      "name": "Angostura bitters",
      "type": "bitter",
      "quantity": {
        "amount": 1,
        "unit": "dash"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Grapefruit juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Simple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Fords Gin",
      "type": "spirit",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Williams & Humbert Dry Sack Medium Sherry",
      "type": "wine",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    },
    {
      "name": "Seltzer",
      "type": "soda",
      "technique": {
        "technique": "application",
        "method": "top"
      },
      "quantity": {
        "amount": 1,
        "unit": "part"
      }
    }
  ],
  "instructions": [
    "Short shake all the ingredients (except the club soda) with ice, then strain into a highball glass filled with ice cubes.",
    "Top with club soda.",
    "Garnish with 1 orange wedge and serve with a straw."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Alex Day"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 230
    }
  ]
}

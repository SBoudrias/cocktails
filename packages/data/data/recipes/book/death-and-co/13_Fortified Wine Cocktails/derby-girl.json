{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Derby Girl",
  "preparation": "shaken",
  "served_on": "crushed ice",
  "glassware": "julep",
  "ingredients": [
    {
      "name": "Nectarine",
      "type": "fruit",
      "technique": [
        {
          "technique": "cut",
          "type": "sliced"
        },
        {
          "technique": "muddled"
        }
      ],
      "quantity": {
        "amount": 3,
        "unit": "unit"
      }
    },
    {
      "name": "Acacia honey syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.25,
        "unit": "oz"
      }
    },
    {
      "name": "Suze",
      "type": "liqueur",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Koval Rose Hip Liqueur",
      "type": "liqueur",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lillet Blanc",
      "type": "wine",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a shaker, muddle the nectarine slices.",
    "Add the remaining ingredients and short shake with ice.",
    "Strain into a julep tin filled with crushed ice.",
    "Garnish with 1 mint bouquet in the center of the ice and serve with a straw."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Jillian Vose"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 229
    }
  ]
}

{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Boomin' Granny",
  "preparation": "shaken",
  "served_on": "up",
  "glassware": "flute",
  "ingredients": [
    {
      "name": "Acacia honey syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Granny Smith apple juice",
      "type": "juice",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Hine Rare VSOP Cognac",
      "type": "spirit",
      "quantity": {
        "amount": 1.5,
        "unit": "oz"
      }
    },
    {
      "name": "Champagne",
      "type": "category",
      "technique": {
        "technique": "application",
        "method": "top"
      },
      "quantity": {
        "amount": 1,
        "unit": "part"
      }
    }
  ],
  "instructions": [
    "Shake all the ingredients (except the champagne) with ice, then strain into a flute.",
    "Top with champagne.",
    "Garnish with the apple slice, dropped into the drink."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Jillian Vose"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 220
    }
  ]
}

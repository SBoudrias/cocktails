{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "The Bitterbender",
  "preparation": "shaken",
  "served_on": "big rock",
  "glassware": "snifter",
  "ingredients": [
    {
      "name": "lemon",
      "type": "fruit",
      "technique": [
        {
          "technique": "cut",
          "type": "peeled"
        },
        {
          "technique": "muddled"
        }
      ],
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "orange",
      "type": "fruit",
      "technique": [
        {
          "technique": "cut",
          "type": "peeled"
        },
        {
          "technique": "muddled"
        }
      ],
      "quantity": {
        "amount": 1,
        "unit": "unit"
      }
    },
    {
      "name": "raspberries",
      "type": "fruit",
      "technique": {
        "technique": "muddled"
      },
      "quantity": {
        "amount": 4,
        "unit": "unit"
      }
    },
    {
      "name": "Ginger syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Campari",
      "type": "liqueur",
      "technique": {
        "technique": "infusion",
        "agent": "cacao nibs"
      },
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Russell's Reserve Bourbon",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    },
    {
      "name": "Champagne",
      "type": "category",
      "technique": {
        "technique": "application",
        "method": "top"
      },
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "In a shaker, muddle the raspberries with the lemon and orange twists.",
    "Add the remaining ingredients (except the champagne) and shake with ice.",
    "Strain into a snifter over 1 large ice cube and top with the champagne.",
    "Garnish with the lemon wheel."
  ],
  "attributions": [
    {
      "relation": "recipe author",

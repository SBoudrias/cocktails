{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Doc Daneeka Royale",
  "preparation": "shaken",
  "served_on": "up",
  "glassware": "coupe",
  "ingredients": [
    {
      "name": "Bittermens Hopped Grapefruit Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 1,
        "unit": "dash"
      }
    },
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Maple syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Plymouth Gin",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    },
    {
      "name": "Champagne",
      "type": "category",
      "technique": {
        "technique": "application",
        "method": "top"
      },
      "quantity": {
        "amount": 1,
        "unit": "part"
      }
    }
  ],
  "instructions": [
    "Shake all the ingredients (except the champagne and grapefruit coin) with ice, then double strain into a coupe.",
    "Top with champagne.",
    "Squeeze the grapefruit coin over the drink and discard.",
    "No garnish."
  ],
  "attributions": [

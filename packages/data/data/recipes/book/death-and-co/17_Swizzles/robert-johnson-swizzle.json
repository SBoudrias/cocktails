{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Robert Johnson Swizzle",
  "preparation": "swizzled",
  "served_on": "crushed ice",
  "glassware": "footed pilsner",
  "ingredients": [
    {
      "name": "Lemon juice",
      "type": "juice",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Vanilla syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Otima 10-Year Tawny Port",
      "type": "wine",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Evan Williams Single-Barrel Bourbon",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    },
    {
      "name": "Fee Brothers Whiskey Barrel-Aged Bitters",
      "type": "bitter",
      "technique": {
        "technique": "application",
        "method": "top"
      },
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Death & Co Peychaud's Bitters",
      "type": "bitter",
      "technique": {
        "technique": "application",
        "method": "top"
      },
      "quantity": {
        "amount": 3,
        "unit": "dash"
      }
    }
  ],
  "instructions": [
    "Dry shake all the ingredients (except the bitters), then dump into a pilsner glass filled with crushed ice. Swizzle until cold. Add the bitters and swizzle them into the top of the drink. Garnish with the mint sprig and serve with a straw."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Brian Miller"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 251
    }
  ]
}

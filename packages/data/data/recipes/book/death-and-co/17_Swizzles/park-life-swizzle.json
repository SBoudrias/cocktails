{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Park Life Swizzle",
  "preparation": "swizzled",
  "served_on": "crushed ice",
  "glassware": "footed pilsner",
  "ingredients": [
    {
      "name": "Ginger syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "John D. Taylor's Velvet Falernum",
      "type": "liqueur",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Ransom Old Tom",
      "type": "spirit",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Lustau Amontillado Sherry",
      "type": "wine",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Angostura bitters",
      "type": "bitter",
      "technique": {
        "technique": "application",
        "method": "top"
      },
      "quantity": {
        "amount": 6,
        "unit": "dash"
      }
    }
  ],
  "instructions": [
    "Dry shake all the ingredients (except the bitters), then dump into a pilsner glass filled with crushed ice. Top with the bitters. Garnish with the mint sprig, and serve with a straw."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Thomas Waugh"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 251
    }
  ]
}

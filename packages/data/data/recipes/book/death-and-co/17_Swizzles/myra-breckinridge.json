{
  "$schema": "../../../../../schemas/recipe.schema.json",
  "name": "Myra Breckinridge",
  "preparation": "swizzled",
  "served_on": "crushed ice",
  "glassware": "footed pilsner",
  "ingredients": [
    {
      "name": "Vieux Pontarlier Absinthe",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Cane syrup",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "Laphroaig 10",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Dry shake all the ingredients, then dump into a pilsner glass filled with crushed ice. Swizzle until cold. Garnish with the mint sprig and serve with a straw."
  ],
  "attributions": [
    {
      "relation": "recipe author",
      "source": "Phil Ward"
    }
  ],
  "refs": [
    {
      "type": "book",
      "title": "Death & Co: Modern Classic Cocktails",
      "page": 250
    }
  ]
}

{
  "$schema": "../../../../schemas/recipe.schema.json",
  "name": "Fast Mojito",
  "preparation": "shaken",
  "served_on": "ice cubes",
  "glassware": "collins",
  "ingredients": [
    {
      "name": "Mint leaves",
      "type": "other",
      "quantity": {
        "amount": 12,
        "unit": "unit"
      }
    },
    {
      "name": "Demerara syrup",
      "type": "syrup",
      "brix": 66,
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "The Real McCoy 3 Year",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    },
    {
      "name": "Seltzer",
      "type": "soda",
      "quantity": {
        "amount": 3,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Clap the mint leaves and tap them around the inside of a collins glass with a barspoon.",
    "Shake rum, Demerara syrup, and lime juice with ice.",
    "Fill the collins glass with ice cubes and strain the drink over the ice.",
    "Lift the mint with a barspoon to incorporate it.",
    "Top with seltzer.",
    "Garnish with a mint sprig."
  ],

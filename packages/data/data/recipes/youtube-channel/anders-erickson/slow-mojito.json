  "instructions": [
    "Clap the mint leaves and add them to a collins glass with Demerara sugar.",
    "Stir gently until the sugar is coated with mint oils without mashing the mint.",
    "Add the lime wedges and press with a muddler three or four times to release juice and oils.",
    "Add rum and stir.",
    "Add ice cubes and top with seltzer.",
    "Stir to incorporate the mint and lime.",
    "Garnish with a mint sprig."
  ],

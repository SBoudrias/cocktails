  "instructions": [
    "Beat egg yolks with sugar and nutmeg in a large mixing bowl until the mixture lightens in color.",
    "Combine dairy, spirits, and salt in a separate vessel.",
    "Slowly beat the dairy and spirits mixture into the egg mixture.",
    "Transfer to glass jars and store sealed in the refrigerator.",
    "Garnish each serving with freshly grated nutmeg."
  ],

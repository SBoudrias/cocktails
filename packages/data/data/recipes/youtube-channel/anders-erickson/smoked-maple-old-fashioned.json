  "name": "Smoked Maple Old Fashioned",
  "preparation": "stirred",
  "served_on": "big rock",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Fee Brothers Black Walnut Bitters",
      "type": "bitter",
      "quantity": {
        "amount": 3,

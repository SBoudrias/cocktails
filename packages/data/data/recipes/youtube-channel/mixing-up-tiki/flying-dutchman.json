{
  "$schema": "../../../../schemas/recipe.schema.json",
  "name": "Flying Dutchman",
  "preparation": "shaken",
  "served_on": "crushed ice",
  "glassware": "footed pilsner",
  "ingredients": [
    {
      "name": "Herbstura",
      "type": "bitter",
      "quantity": {
        "amount": 2,
        "unit": "dash"
      }
    },
    {
      "name": "Lime juice",
      "type": "juice",
      "quantity": {
        "amount": 0.75,
        "unit": "oz"
      }
    },
    {
      "name": "BG Reynolds Falernum",
      "type": "syrup",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Pineapple juice",
      "type": "juice",
      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Planteray OFTD",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Add all the ingredients to a shaking tin with ice.",
    "Whip shake for 8-10 seconds.",
    "Open pour into a footed pilsner glass and top with crushed ice.",
    "Garnish with pineapple fronds and an edible flower, then add a straw."
  ],

  "name": "Virgin Halekulani",
  "preparation": "shaken",
  "served_on": "crushed ice",
  "glassware": "old fashioned",
  "ingredients": [
    {
      "name": "Grenadine",
      "type": "syrup",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Pineapple Molasses Syrup",

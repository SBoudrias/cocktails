      "quantity": {
        "amount": 1,
        "unit": "oz"
      }
    },
    {
      "name": "Pierre Ferrand Dry Curaçao",
      "type": "liqueur",
      "quantity": {
        "amount": 0.5,
        "unit": "oz"
      }
    },
    {
      "name": "Planteray Stiggins' Fancy pineapple rum",
      "type": "spirit",
      "quantity": {
        "amount": 2,
        "unit": "oz"
      }
    }
  ],
  "instructions": [
    "Grill the pineapple before juicing, then acid adjust the pineapple juice.",
    "Smoke the pineapple rum before use.",

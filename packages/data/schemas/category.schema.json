{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./category.schema.json",
  "title": "Category",
  "description": "A liqueur or spirit category",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "categoryType": {
      "enum": [
        "beer",
        "bitter",
        "emulsifier",
        "fruit",
        "juice",
        "liqueur",
        "puree",
        "soda",
        "spice",
        "spirit",
        "syrup",
        "tincture",
        "wine",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "substitutable": {
      "description": "Whether the children of this category substitute with each other. False for flavor or appellation islands — e.g. Vodka, whose chili pepper, chocolate and citrus children each keep their own flavor. The category's own bottles still substitute with each other; only the sibling expansion is dropped. Omit for the default, true.",
      "type": "boolean"
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "refs": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "youtube"
              },
              "videoId": {
                "type": "string"
              },
              "channel": {
                "description": "Slug of the youtube-channel source that published the video",
                "type": "string"
              },
              "start": {
                "type": "number"
              }
            },
            "required": ["type", "videoId", "channel"],
            "additionalProperties": false
          }
        ]
      }
    },
    "outsideOf": {
      "description": "Categorization systems this category and its subtree are outside of",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "required": ["name", "categoryType"],
  "additionalProperties": false
}

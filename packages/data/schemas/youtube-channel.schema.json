{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./youtube-channel.schema.json",
  "title": "Youtube Channel",
  "description": "A Youtube channel",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "description": "The name of the channel",
      "type": "string"
    },
    "links": {
      "description": "Links to the channel pages",
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "description": {
      "description": "Description of the channel content",
      "type": "string"
    },
    "reviewedVideos": {
      "description": "Channel videos that have been reviewed for recipe backfill but intentionally do not have recipe refs.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "videoId": { "type": "string" },
          "status": { "enum": ["skip", "uncertain"] },
          "reason": { "type": "string" }
        },
        "required": ["videoId", "status", "reason"],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": ["name", "links", "description"],
  "additionalProperties": false
}

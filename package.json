{
  "name": "cocktails-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "yarn workspace @cocktails/web dev",
    "lint": "yarn workspaces foreach -A run lint && oxlint . && oxfmt . --check",
    "test": "vitest --run --coverage",
    "check-data": "turbo run check-data --filter=@cocktails/data",
    "youtube-inventory": "yarn workspace @cocktails/youtube-sync inventory",
    "youtube-sync": "yarn workspace @cocktails/youtube-sync youtube-sync",
    "prepare": "git config --local include.path ../.gitconfig || true"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.77.0",
    "turbo": "^2.10.7",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "dependenciesMeta": {
    "core-js": {
      "built": false
    }
  },
  "volta": {
    "node": "24.13.0"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}

{
  "name": "cocktails-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "yarn workspace @cocktails/web dev",
    "knip": "knip",
    "lint": "yarn workspaces foreach -A run lint && oxlint . --type-aware && oxfmt . --check",
    "test": "vitest --run --coverage",
    "check-data": "turbo run check-data --filter=@cocktails/data",
    "youtube-inventory": "yarn workspace @cocktails/youtube-sync inventory",
    "youtube-sync": "yarn workspace @cocktails/youtube-sync youtube-sync",
    "prepare": "git config --local include.path ../.gitconfig || true"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "knip": "^6.45.1",
    "msw": "^3.0.5",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.94.0",
    "oxlint-tailwindcss": "1.17.2",
    "skills": "1.9.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "turbo": "^2.11.10",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependenciesMeta": {
    "core-js": {
      "built": false
    }
  },
  "volta": {
    "node": "24.13.0"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
